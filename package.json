{
  "name": "opencode-novel-plugin",
  "version": "0.0.0",
  "description": "OpenCode plugin for AI-assisted novel writing with structured workflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/wmzy/opencode-novel-plugin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir test-out && node --test \"test-out/**/*.test.js\""
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "novel",
    "writing",
    "ai",
    "creative-writing"
  ],
  "license": "AGPL-3.0-or-later"
}
