{
  "name": "@jin-shiroyama/opencode-novel-plugin",
  "version": "0.0.0",
  "description": "OpenCode plugin for writing long-form fiction in Japanese, with a staged workflow from premise to manuscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jin-Shiroyama/opencode-novel-plugin"
  },
  "homepage": "https://github.com/Jin-Shiroyama/opencode-novel-plugin#readme",
  "bugs": {
    "url": "https://github.com/Jin-Shiroyama/opencode-novel-plugin/issues"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "commands",
    "skills",
    "README.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir test-out && node --test \"test-out/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "check:ja": "node scripts/check-japanese.mjs"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "novel",
    "writing",
    "ai",
    "creative-writing",
    "japanese",
    "日本語",
    "小説",
    "長編小説"
  ]
}
